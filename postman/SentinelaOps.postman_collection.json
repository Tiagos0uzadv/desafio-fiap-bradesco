          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const lista = pm.response.json();",
                  "if (lista.length > 0) {",
                  "  pm.collectionVariables.set('acaoId', lista[0].id);",
                  "  console.log('acaoId guardado:', lista[0].id);",
                  "} else {",
                  "  console.log('nenhuma acao pendente: rode o passo 3 mais vezes');",
                  "}",
                  "pm.test('existe acao pendente', () => pm.expect(lista.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
