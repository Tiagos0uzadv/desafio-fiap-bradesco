            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('aprovado', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('ficou executada', () => pm.expect(a.status).to.eql('executada'));",
                  "pm.test('registrou quem autorizou', () => pm.expect(a.autorizado_por).to.eql('operador'));"
                ]
              }
            }
          ]
        },
